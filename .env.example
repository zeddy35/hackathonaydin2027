# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# e.g. "Hackathon Aydın <bilgi@your-domain>" (needs a verified domain)
EMAIL_FROM=

# Public site address. Defaults to https://hackathonaydin.vercel.app
NEXT_PUBLIC_SITE_URL=

# Comma-separated. These accounts become owner on first sign-in.
OWNER_EMAILS=
